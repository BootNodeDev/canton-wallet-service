# wallet-service config, read by src/config.ts. The values below reach a Splice
# LocalNet on the host; in a container the Canton and Splice hosts become
# host.docker.internal or a compose service name.

WALLET_SERVICE_PORT=3010
WALLET_SERVICE_CORS_ORIGINS=http://localhost:3011

NETWORK=canton:localnet
WALLET_PROVIDER_ID=wallet-service
WALLET_PROVIDER_VERSION=0.1.0
WALLET_PROVIDER_URL=http://localhost:3010
WALLET_PROVIDER_USER_URL=http://localhost:3010

# Splice LocalNet app-user participant, as reachable from the host.
CANTON_JSON_API_URL=http://localhost:2975
CANTON_LEDGER_API_URL=grpc://localhost:2901
CANTON_ADMIN_API_URL=grpc://localhost:2902

# Splice validator / scan endpoints used by the CIP-56 token SDK.
SPLICE_VALIDATOR_URL=http://localhost:2000/api/validator
SPLICE_SCAN_API_URL=http://scan.localhost:4000/api/scan
SPLICE_REGISTRY_API_URL=http://localhost:2000/api/validator/v0/scan-proxy

# --- Canton credentials: pick one path ---------------------------------------
#
# 1. Static token (LocalNet). A bearer token the participant's ledger API
#    accepts, minted by whoever runs the participant (subject `ledger-api-user`
#    on Splice LocalNet). Required unless the OAuth path below is configured.
CANTON_BACKEND_TOKEN=

# 2. OAuth client credentials (a hosted validator). Setting any EXTERNAL_OAUTH_*
#    variable selects this path, and CANTON_BACKEND_TOKEN is then neither read
#    nor needed. The service fetches, caches and refreshes the token itself.
#
#    On this path no localhost default stands in for an endpoint: CANTON_JSON_API_URL,
#    SPLICE_VALIDATOR_URL, SPLICE_SCAN_API_URL and SPLICE_REGISTRY_API_URL must all
#    name the hosted validator, or come from EXTERNAL_PRESET.
#
# EXTERNAL_OAUTH_TOKEN_URL=https://auth.example/oauth/token
# EXTERNAL_OAUTH_CLIENT_ID=
# EXTERNAL_OAUTH_CLIENT_SECRET=
# EXTERNAL_OAUTH_SCOPE=daml_ledger_api
#
#    EXTERNAL_PRESET fills the endpoints and OAuth defaults for a known validator,
#    leaving only EXTERNAL_OAUTH_CLIENT_SECRET to supply. Presets never carry secrets.
# EXTERNAL_PRESET=fivenorth
